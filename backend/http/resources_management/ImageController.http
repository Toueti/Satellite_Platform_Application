@baseUrl = http://localhost:8080/geospatial/images

### Add a new image to a project
# @name addImage
POST {{baseUrl}}/add
Content-Type: application/json

{
  "projectId": "65e4494799452b2b15d33c99",
  "name": "Test Image",
  "description": "This is a test image",
  "imageUrl": "http://example.com/image.tif"
}

### Rename image
# @name renameImage
PUT {{baseUrl}}/65e4494799452b2b15d33c99/rename?newName=NewImageName&projectId=65e4494799452b2b15d33c99

### Get all images with pagination
# @name getAllImages
GET {{baseUrl}}?page=0&size=10

### Get image by name and project ID
# @name getImageByName
GET {{baseUrl}}/name/65e4494799452b2b15d33c99/Test Image

### Get image by ID
# @name getImageById
GET {{baseUrl}}/65e4494799452b2b15d33c99

### Delete an image by ID
# @name deleteImage
DELETE {{baseUrl}}/65e4494799452b2b15d33c99

### Get all images for a project
# @name getImagesByProject
GET {{baseUrl}}/by-project/65e4494799452b2b15d33c99

### Delete all images for a project
# @name deleteAllImagesByProject
DELETE {{baseUrl}}/by-project/65e4494799452b2b15d33c99

### Get image by ID and project ID
# @name getImageByImageIdAndProject
GET {{baseUrl}}/65e4494799452b2b15d33c99/project/65e4494799452b2b15d33c99

### Delete image by ID and project ID
# @name deleteImageByProject
DELETE {{baseUrl}}/65e4494799452b2b15d33c99/project/65e4494799452b2b15d33c99

### Bulk delete images by IDs
# @name bulkDeleteImages
DELETE {{baseUrl}}/bulk-delete
Content-Type: application/json

[
  "65e4494799452b2b15d33c99",
  "65e4494799452b2b15d33c98"
]

### Count images in a project
# @name countImagesByProject
GET {{baseUrl}}/count/65e4494799452b2b15d33c99
